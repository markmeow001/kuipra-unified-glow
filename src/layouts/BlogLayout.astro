---
interface Props {
  lang: 'en' | 'zh';
  title: string;
  description: string;
  /** Path of this page, e.g. /blog/foo/ */
  path: string;
  /** Path of the same page in the other language, for hreflang + toggle */
  altPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: object[];
  /** Which nav item is highlighted. */
  active?: 'journal' | 'services';
}

const {
  lang,
  title,
  description,
  path,
  altPath,
  ogImage = '/og-image.jpg',
  ogType = 'website',
  jsonLd = [],
  active = 'journal',
} = Astro.props;

const SITE = 'https://www.kuipra.ca';
const canonical = SITE + path;
const enUrl = lang === 'en' ? canonical : altPath ? SITE + altPath : undefined;
const zhUrl = lang === 'zh' ? canonical : altPath ? SITE + altPath : undefined;
const blogHome = lang === 'zh' ? '/zh/blog/' : '/blog/';
const servicesHome = lang === 'zh' ? '/zh/services/' : '/services/';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Kuipra Communications',
  url: SITE,
  logo: SITE + '/kuipra-logo.png',
  email: 'charlene.ling@kuipra.ca',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Vancouver',
    addressRegion: 'BC',
    addressCountry: 'CA',
  },
  sameAs: ['https://www.instagram.com/kuipra_communications/'],
};

const t = {
  services: lang === 'zh' ? '服務' : 'Services',
  about: lang === 'zh' ? '關於' : 'About',
  work: lang === 'zh' ? '案例' : 'Work',
  journal: lang === 'zh' ? '專欄' : 'Journal',
  contact: lang === 'zh' ? '聯繫我們' : 'Get in touch',
  langLabel: lang === 'zh' ? 'EN' : '中文',
  copy:
    lang === 'zh'
      ? '© 2026 Kuipra Communications。版權所有。'
      : '© 2026 Kuipra Communications. All rights reserved.',
};
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-Hant' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kuipra Communications" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {zhUrl && <link rel="alternate" hreflang="zh-Hant" href={zhUrl} />}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a1628" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={SITE + ogImage} />
    <meta property="og:site_name" content="Kuipra Communications" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_TW' : 'en_CA'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={SITE + ogImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Kuipra Journal"
      href={lang === 'zh' ? '/zh/rss.xml' : '/rss.xml'}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:wght@300;400;500&family=DM+Mono:wght@400&family=Noto+Serif+TC:wght@500;700&display=swap"
      rel="stylesheet"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(orgLd)}
    />
    {jsonLd.map((ld) => (
      <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    ))}
    <script defer src="/_vercel/insights/script.js" is:inline></script>
  </head>
  <body>
    <nav>
      <a href="/" class="nav-logo"
        ><img src="/kuipra-logo.png" alt="Kuipra Communications" /></a
      >
      <div class="nav-links">
        <a href={servicesHome} class={active === 'services' ? 'nav-active' : ''}
          >{t.services}</a
        >
        <a href="/#about">{t.about}</a>
        <a href="/#projects">{t.work}</a>
        <a href={blogHome} class={active === 'journal' ? 'nav-active' : ''}
          >{t.journal}</a
        >
        {altPath && <a href={altPath} class="nav-lang">{t.langLabel}</a>}
        <a
          href="mailto:Charlene.Ling@Kuipra.Ca?subject=Hello%20Kuipra"
          class="nav-cta">{t.contact}</a
        >
      </div>
      {altPath && <a href={altPath} class="nav-lang nav-lang-mobile">{t.langLabel}</a>}
    </nav>

    <slot />

    <footer>
      <div class="footer-bottom">
        <span class="footer-copy">{t.copy}</span>
        <span class="footer-copy">kuipra.ca</span>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  :root {
    --ink: #0d0d0d;
    --ink-soft: #3a3a3a;
    --ink-faint: #888;
    --paper: #f7f5f0;
    --paper-pure: #ffffff;
    --deep: #0a1628;
    --deep-mid: #112240;
    --orange: #e85d26;
    --orange-soft: rgba(232, 93, 38, 0.12);
    --rule: rgba(13, 13, 13, 0.1);
    --rule-light: rgba(255, 255, 255, 0.12);
    --serif: 'Playfair Display', 'Noto Serif TC', serif;
    --sans: 'DM Sans', sans-serif;
    --mono: 'DM Mono', monospace;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    font-family: var(--sans);
    background: var(--paper);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 48px;
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-logo img {
    height: 34px;
    display: block;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .nav-links a {
    font-size: 14px;
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--orange);
  }
  .nav-links a.nav-active {
    color: var(--ink);
    border-bottom: 2px solid var(--orange);
    padding-bottom: 2px;
  }
  .nav-lang {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    opacity: 0.75;
  }
  .nav-lang-mobile {
    display: none;
  }
  .nav-cta {
    border: 1px solid var(--ink);
    padding: 10px 22px;
    border-radius: 100px;
    color: var(--ink) !important;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .nav-cta:hover {
    background: var(--orange);
    border-color: var(--orange);
    color: var(--paper) !important;
  }

  .journal-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 48px;
  }
  .journal-eyebrow {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--orange);
  }

  footer {
    border-top: 1px solid var(--rule);
    margin-top: 120px;
    padding: 32px 48px;
  }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .footer-copy {
    font-size: 13px;
    color: var(--ink-faint);
  }

  @media (max-width: 768px) {
    nav {
      padding: 16px 24px;
    }
    .nav-links {
      display: none;
    }
    .nav-lang-mobile {
      display: block;
    }
    .journal-wrap {
      padding: 0 24px;
    }
    footer {
      padding: 24px;
    }
  }
</style>
