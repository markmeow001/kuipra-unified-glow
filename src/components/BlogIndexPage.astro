---
import BlogLayout from '../layouts/BlogLayout.astro';
import { CATEGORIES, CATEGORY_SLUGS, type CategorySlug } from '../data/categories';
import { getPosts, postPath, formatDate, type Post } from '../lib/blog';

interface Props {
  lang: 'en' | 'zh';
  /** When set, only show this category. */
  category?: CategorySlug;
}

const { lang, category } = Astro.props;

const allPosts = await getPosts(lang);
const posts = category
  ? allPosts.filter((p) => p.data.category === category)
  : allPosts;

const base = lang === 'zh' ? '/zh/blog/' : '/blog/';
const altBase = lang === 'zh' ? '/blog/' : '/zh/blog/';
const path = category ? `${base}category/${category}/` : base;
const altPath = category ? `${altBase}category/${category}/` : altBase;

const heading =
  category
    ? CATEGORIES[category][lang]
    : lang === 'zh'
      ? 'Kuipra 專欄'
      : 'The Kuipra Journal';
const intro = category
  ? lang === 'zh'
    ? CATEGORIES[category].descZh
    : CATEGORIES[category].descEn
  : lang === 'zh'
    ? '品牌策略、案例拆解、溫哥華在地行銷與 AI 行銷洞察——來自 Kuipra 團隊的第一手筆記。'
    : 'Brand strategy, campaign breakdowns, Vancouver marketing playbooks, and AI marketing insights — field notes from the Kuipra team.';

const title = category
  ? `${heading} | Kuipra Journal`
  : lang === 'zh'
    ? 'Kuipra 專欄｜品牌策略與行銷洞察'
    : 'The Kuipra Journal | Marketing Insights from Vancouver';

const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'The Kuipra Journal',
  url: 'https://www.kuipra.ca' + path,
  description: intro,
  publisher: { '@type': 'Organization', name: 'Kuipra Communications' },
};

function excerpt(post: Post): string {
  return post.data.description;
}
---

<BlogLayout
  lang={lang}
  title={title}
  description={intro}
  path={path}
  altPath={altPath}
  jsonLd={[blogLd]}
>
  <header class="journal-wrap journal-head">
    <p class="journal-eyebrow">
      {lang === 'zh' ? '專欄 · 溫哥華' : 'Journal · Vancouver'}
    </p>
    <h1>{heading}</h1>
    <p class="journal-intro">{intro}</p>
  </header>

  <div class="journal-wrap">
    <div class="cat-nav">
      <a href={base} class={!category ? 'cat-on' : ''}>
        {lang === 'zh' ? '全部' : 'All'}
      </a>
      {CATEGORY_SLUGS.map((slug) => (
        <a
          href={`${base}category/${slug}/`}
          class={category === slug ? 'cat-on' : ''}
        >
          {CATEGORIES[slug][lang]}
        </a>
      ))}
    </div>

    {posts.length === 0 && (
      <p class="journal-empty">
        {lang === 'zh' ? '文章即將上線。' : 'Articles coming soon.'}
      </p>
    )}

    <div class="post-list">
      {posts.map((post) => (
        <a href={postPath(post)} class="post-card">
          {post.data.heroImage && (
            <img
              src={post.data.heroImage}
              alt={post.data.heroImageAlt ?? post.data.title}
              loading="lazy"
            />
          )}
          <div class="post-card-body">
            <p class="post-meta">
              <span class="post-cat">{CATEGORIES[post.data.category][lang]}</span>
              <span>{formatDate(post.data.pubDate, lang)}</span>
            </p>
            <h2>{post.data.title}</h2>
            <p class="post-excerpt">{excerpt(post)}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</BlogLayout>

<style>
  .journal-head {
    padding-top: 96px;
    padding-bottom: 48px;
  }
  h1 {
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 700;
    margin-top: 16px;
    line-height: 1.1;
  }
  .journal-intro {
    margin-top: 20px;
    max-width: 560px;
    color: var(--ink-soft);
    font-size: 17px;
    line-height: 1.6;
    font-weight: 300;
  }
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 40px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 56px;
  }
  .cat-nav a {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 100px;
    padding: 8px 18px;
    transition: all 0.2s;
  }
  .cat-nav a:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .cat-nav a.cat-on {
    background: var(--deep);
    border-color: var(--deep);
    color: var(--paper);
  }
  .journal-empty {
    color: var(--ink-faint);
    padding: 40px 0 80px;
  }
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 40px 32px;
  }
  .post-card {
    text-decoration: none;
    color: var(--ink);
    background: var(--paper-pure);
    border: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(13, 13, 13, 0.08);
  }
  .post-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }
  .post-card-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .post-cat {
    color: var(--orange);
  }
  .post-card h2 {
    font-family: var(--serif);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
  }
  .post-excerpt {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    font-weight: 300;
  }
</style>
